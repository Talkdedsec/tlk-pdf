{
  "name": "tlk-pdf",
  "productName": "TLK PDF",
  "version": "1.0.1",
  "description": "Free, open-source PDF editor that runs on your device: text, signatures, form filling, highlights, drawing, white-out, merge, split, reorder and rotate pages.",
  "license": "MIT",
  "author": "Talkdedsec",
  "homepage": "https://talkdedsec.github.io/tlk-pdf/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Talkdedsec/tlk-pdf.git"
  },
  "bugs": {
    "url": "https://github.com/Talkdedsec/tlk-pdf/issues"
  },
  "private": true,
  "main": "desktop/main.js",
  "scripts": {
    "serve": "node scripts/serve.mjs",
    "start": "electron .",
    "test": "node scripts/smoke.mjs",
    "test:desktop": "node scripts/smoke-desktop.mjs",
    "vendor": "node scripts/vendor.mjs",
    "sample": "node scripts/make-sample.mjs",
    "assets": "node scripts/render-assets.mjs",
    "dist": "electron-builder --win --x64 --publish never",
    "demo": "node scripts/render-demo.mjs en && node scripts/render-demo.mjs tr"
  },
  "build": {
    "appId": "com.talkdedsec.tlkpdf",
    "productName": "TLK PDF",
    "copyright": "Copyright (c) 2026 Talkdedsec",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "desktop/**",
      "web/**",
      "package.json",
      "LICENSE"
    ],
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF document",
        "description": "PDF document",
        "role": "Editor",
        "icon": "build/icon.ico"
      }
    ],
    "win": {
      "target": [
        "portable",
        "nsis",
        "zip"
      ],
      "icon": "build/icon.png",
      "artifactName": "tlk-pdf-${version}-win-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "tlk-pdf-${version}-portable.exe"
    },
    "nsis": {
      "artifactName": "tlk-pdf-${version}-setup.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "TLK PDF"
    },
    "electronLanguages": [
      "en-US",
      "tr"
    ]
  },
  "devDependencies": {
    "@fontsource/caveat": "5.3.0",
    "@ibm/plex-mono": "2.5.0",
    "@ibm/plex-sans": "1.1.0",
    "@ibm/plex-serif": "2.0.0",
    "@pdf-lib/fontkit": "1.1.1",
    "electron": "44.5.1",
    "electron-builder": "26.17.0",
    "fflate": "0.8.3",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "playwright-core": "1.63.0"
  }
}
