{
  "name": "TLK PDF",
  "short_name": "TLK PDF",
  "description": "Edit PDFs on your device: text, signatures, forms, highlights, merge and split.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#E7EAF0",
  "theme_color": "#2449C9",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "application/pdf": [".pdf"] } }
  ]
}
